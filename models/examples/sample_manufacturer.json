    "revenue": {"method": "price_volume", "params": {"volume": {"line": "units"}, "price": {"line": "price"}}},
    "cogs":    {"method": "fixed_variable", "params": {"of": "revenue", "fixed_growth": 0.01}},
    "sga":     {"method": "hist_avg_pct_of", "params": {"of": "revenue", "years": 3}},
    "capex":   {"method": "pct_of", "params": {"of": "revenue", "pct": 0.054, "source": "mid-term plan capex/sales (example)"}},
    "da":      {"method": "pct_of_prior", "params": {"of": "capex", "pct": 0.75, "source": "D&A/prior capex ratio (example)"}},
    "non_operating": {"method": "values", "params": {"values": 8, "source": "flat at 3y average (example)"}}
  },
  "assumptions": {"tax_rate": 0.30, "minority_pct": 0.02, "payout_ratio": 0.35, "dso": 60, "dio": 50, "dpo": 45,
                  "shares": 400, "per_share_factor": 1000},
  "valuation": {
    "wacc": {"rf": 0.01, "beta": 1.1, "erp": 0.06, "cost_of_debt": 0.012, "tax_rate": 0.30, "debt_weight": 0.2},
    "terminal_growth": 0.01, "exit_ev_ebitda": 7.0, "net_debt": 120, "book_equity": 900,
