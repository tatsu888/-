    "current_price": 2000
  },
  "scenarios": {
    "bull": {"lines.units.params.rates": [0.05, 0.05, 0.04, 0.03, 0.03], "probability": 0.25, "description": "volume recovery"},
    "base": {"probability": 0.5, "description": "as modelled"},
    "bear": {"lines.units.params.rates": [-0.02, 0.0, 0.01, 0.01, 0.01], "probability": 0.25, "description": "demand slowdown"}
  },
  "sensitivity": {
    "x": {"path": "valuation.wacc.erp", "values": [0.05, 0.055, 0.06, 0.065, 0.07]},
    "y": {"path": "valuation.terminal_growth", "values": [0.0, 0.005, 0.01, 0.015, 0.02]},
    "output": "valuation.dcf.price_per_share"
  },
  "monte_carlo": {
    "n": 500, "seed": 7, "output": "valuation.dcf.price_per_share", "current_price": 2000,
    "drivers": {
