# Copy values into your shell / launcher. All optional. Full list: docs/CONFIG.md
TERMINAL_PROVIDER=tradingview        # tradingview | yahoo | sim  (UI can switch at runtime)
TV_AUTH_TOKEN=unauthorized_user_token  # logged-in TradingView token => real-time where your plan allows
YAHOO_POLL_SEC=5
TERMINAL_EXCEL_DIRS=                  # e.g. C:\Users\me\Models;D:\Shared\Models  (os.pathsep separated)
TERMINAL_EXCEL_WRITE=auto             # auto (xlwings if available, else safe openpyxl) | xlwings | openpyxl | off
TERMINAL_DATA_DIR=                    # default: <repo>/data
X_BEARER_TOKEN=  # X API v2 bearer token for TRND (paid tier). Secret — never commit
